{
  "name": "AI Operator Intro",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install -g @github/copilot",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
